<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jornadas · Welcome Weddings</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F8F7F5;--surface:#FFFFFF;--surface2:#FAFAF8;
  --border:#ECEAE4;--border2:#E0DDD5;
  --text:#1A1916;--text2:#5C5A55;--text3:#9A9890;
  --accent:#8B6A3E;--accent-light:#F0E8DB;--accent-mid:#C9A87C;
  --red:#C0392B;--red-bg:#FDF3F2;--red-border:#F5C6C2;
  --orange:#D4700A;--orange-bg:#FEF6EE;--orange-border:#F9D4A3;
  --green:#2E7D52;--green-bg:#F0F8F3;--green-border:#A8D9BC;
  --blue:#2563A8;--blue-bg:#EFF5FD;--blue-border:#BFCFE8;
  --purple:#5B3FA6;--purple-bg:#F3F0FB;--purple-border:#C9BDE8;
  --gray-bg:#F4F3F0;--gray-border:#DDDBD4;
  --radius:10px;--radius-sm:6px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:14px}

/* ── HEADER ── */
header{background:var(--surface);border-bottom:1px solid var(--border);padding:0 40px;position:sticky;top:0;z-index:100;display:flex;align-items:stretch;gap:0}
.header-brand{display:flex;align-items:center;gap:12px;padding:16px 0;margin-right:32px;border-right:1px solid var(--border)}
.header-logo{width:32px;height:32px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:14px;color:#fff;font-weight:600;margin-right:4px}
.header-title{font-family:'Playfair Display',serif;font-size:16px;font-weight:600;color:var(--text)}
.header-sub{font-size:11px;color:var(--text3);margin-top:1px}
.header-tabs{display:flex;align-items:stretch;gap:0}
.tab-btn{padding:0 20px;font-size:13px;font-family:'Inter',sans-serif;font-weight:500;color:var(--text2);border:none;background:none;cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap}
.tab-btn:hover{color:var(--text)}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent)}
.header-right{margin-left:auto;display:flex;align-items:center;gap:24px;padding:16px 0}
.stat-group{display:flex;gap:20px}
.stat{text-align:center}
.stat-num{font-size:18px;font-weight:600;line-height:1;font-family:'Playfair Display',serif}
.stat-label{font-size:10px;color:var(--text3);margin-top:1px;letter-spacing:.04em;text-transform:uppercase}

/* ── PROGRESS ── */
.progress-bar-wrap{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 40px;display:flex;align-items:center;gap:14px}
.progress-bar-bg{flex:1;background:var(--border);border-radius:99px;height:4px;overflow:hidden}
.progress-bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent-mid),var(--green));transition:width .5s ease;width:0%}
.progress-txt{font-size:11px;color:var(--text3);white-space:nowrap}

/* ── FILTERS ── */
.filters{background:var(--surface);border-bottom:1px solid var(--border);padding:10px 40px;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.filters-lbl{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:.05em;margin-right:4px}
.fbtn{border:1px solid var(--border2);background:var(--surface);border-radius:99px;padding:4px 12px;font-size:12px;font-family:'Inter',sans-serif;cursor:pointer;color:var(--text2);transition:all .15s}
.fbtn:hover{border-color:var(--accent-mid);color:var(--accent)}
.fbtn.active{background:var(--accent);border-color:var(--accent);color:#fff}

/* ── MAIN ── */
main{padding:24px 40px;max-width:1200px;margin:0 auto}

/* ── FASE ── */
.fase{margin-bottom:24px}
.fase-hd{display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer;user-select:none;padding:8px 0}
.fase-line{flex:1;height:1px;background:var(--border)}
.fase-chip{font-size:11px;font-weight:600;padding:3px 10px;border-radius:99px;letter-spacing:.02em;white-space:nowrap}
.fase-prog{font-size:11px;color:var(--text3)}
.fase-tog{font-size:12px;color:var(--text3);transition:transform .2s}
.fase-tog.open{transform:rotate(180deg)}
.fase-body{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:8px}
.fase-body.collapsed{display:none}

/* ── CARD ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:box-shadow .18s,transform .18s;cursor:default;position:relative}
.card:hover{box-shadow:0 2px 16px rgba(0,0,0,.07);transform:translateY(-1px)}
.card-stripe{position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:var(--radius) 0 0 var(--radius)}
.card.todo .card-stripe{background:var(--border2)}
.card.doing{background:var(--orange-bg);border-color:var(--orange-border)}
.card.doing .card-stripe{background:var(--orange)}
.card.done{background:var(--green-bg);border-color:var(--green-border)}
.card.done .card-stripe{background:var(--green)}

/* CARD HEAD */
.card-head{padding:12px 12px 10px 16px}
.card-top{display:flex;gap:8px;align-items:flex-start;margin-bottom:8px}
.card-title-ta{font-size:13px;font-weight:500;flex:1;border:none;background:transparent;font-family:'Inter',sans-serif;color:var(--text);resize:none;outline:none;min-height:18px;line-height:1.45;padding:0;cursor:text}
.card-title-ta:focus{background:rgba(0,0,0,.03);border-radius:4px;padding:2px 4px;margin:-2px -4px}
.card.done .card-title-ta{text-decoration:line-through;color:var(--text3)}
.card-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:5px;background:var(--border2)}
.card.doing .card-dot{background:var(--orange)}
.card.done .card-dot{background:var(--green)}
.card-foot{display:flex;align-items:center;justify-content:space-between;gap:6px;flex-wrap:wrap}
.tags{display:flex;gap:4px;flex-wrap:wrap}
.tag{font-size:10px;padding:2px 7px;border-radius:99px;font-weight:500;white-space:nowrap;line-height:1.4}
.status-sel{border:1px solid var(--border2);border-radius:var(--radius-sm);padding:3px 7px;font-size:11px;font-family:'Inter',sans-serif;background:var(--bg);color:var(--text2);cursor:pointer;outline:none}
.status-sel:hover{border-color:var(--accent-mid)}

/* EXPAND BTN */
.card-expbtn{width:100%;background:none;border:none;border-top:1px solid var(--border);padding:6px 12px 6px 16px;font-size:11px;color:var(--text3);cursor:pointer;text-align:left;font-family:'Inter',sans-serif;display:flex;align-items:center;gap:4px;transition:background .12s}
.card-expbtn:hover{background:var(--bg)}
.card-expbtn .arr{transition:transform .18s;display:inline-block;font-size:10px}
.card-expbtn.open .arr{transform:rotate(180deg)}

/* CARD DETAIL */
.card-det{display:none;padding:12px 12px 14px 16px;border-top:1px solid var(--border);background:var(--surface2)}
.card-det.open{display:block}
.det-sec{margin-bottom:11px}
.det-sec:last-child{margin-bottom:0}
.det-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);margin-bottom:4px;font-weight:600}
.det-input{width:100%;border:1px solid var(--border2);border-radius:var(--radius-sm);padding:6px 8px;font-size:12px;font-family:'Inter',sans-serif;background:var(--surface);color:var(--text);outline:none;transition:border-color .15s;line-height:1.5}
.det-input:focus{border-color:var(--accent-mid);box-shadow:0 0 0 2px var(--accent-light)}
.det-input::placeholder{color:var(--text3)}
textarea.det-input{resize:vertical;min-height:56px}
.det-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}

/* LISTAS COLORIDAS */
.list-wrap{display:flex;flex-direction:column;gap:4px}
.list-row{display:flex;gap:5px;align-items:flex-start}
.list-ta{flex:1;border-radius:var(--radius-sm);padding:5px 8px;font-size:12px;font-family:'Inter',sans-serif;outline:none;resize:none;min-height:30px;line-height:1.4;transition:border-color .15s}
.list-ta:focus{box-shadow:0 0 0 2px rgba(0,0,0,.06)}

/* problema = vermelho suave */
.prob-ta{background:#FEF9F9;border:1px solid var(--red-border);color:#7A1515}
.prob-ta:focus{border-color:#E07070}
.prob-ta::placeholder{color:#C08080;opacity:.7}

/* solucao = verde suave */
.sol-ta{background:#F5FAF7;border:1px solid var(--green-border);color:#1A4D32}
.sol-ta:focus{border-color:#6DBD90}
.sol-ta::placeholder{color:#5A9A72;opacity:.7}

.btn-rm{border:1px solid var(--border2);background:none;border-radius:var(--radius-sm);width:26px;height:26px;cursor:pointer;font-size:13px;color:var(--text3);flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .15s;margin-top:2px}
.btn-rm:hover{background:var(--red-bg);border-color:var(--red-border);color:var(--red)}
.btn-add{border:1px dashed var(--border2);background:none;border-radius:var(--radius-sm);padding:4px 10px;font-size:11px;font-family:'Inter',sans-serif;color:var(--text3);cursor:pointer;transition:all .15s;margin-top:3px;width:100%;text-align:left}
.btn-add:hover{border-color:var(--accent-mid);color:var(--accent)}

/* PANELS */
.panel{display:none}
.panel.active{display:block}

/* EMPTY */
.empty{text-align:center;padding:48px;color:var(--text3);font-size:14px;display:none}
footer{text-align:center;padding:24px;font-size:11px;color:var(--text3);border-top:1px solid var(--border);margin-top:32px}

@media(max-width:640px){
  header{padding:0 16px;flex-wrap:wrap}
  main,.filters,.progress-bar-wrap{padding-left:16px;padding-right:16px}
  .fase-body{grid-template-columns:1fr}
  .header-right{display:none}
}
</style>
</head>
