// ─────────────────────────────────────────────
// STATE
// ─────────────────────────────────────────────
function loadState(){ try{ const s=localStorage.getItem(SK); if(s) state=JSON.parse(s); }catch(e){ state={}; } }
function saveState(){ try{ localStorage.setItem(SK,JSON.stringify(state)); }catch(e){} }
function getCS(idx){
  if(!state[idx]) state[idx]={status:'todo',titulo:'',processo:'',responsavel:'',prazo:'',problemas:[],solucoes:[]};
  return state[idx];
}
function autoResize(ta){ ta.style.height='auto'; ta.style.height=ta.scrollHeight+'px'; }
function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ─────────────────────────────────────────────
// RENDER
// ─────────────────────────────────────────────
function renderAll(){
  cardIdx=0;
  ['casal','convidado'].forEach(tab=>{
    const panel=document.getElementById('panel-'+tab);
    panel.innerHTML='';
    DATA[tab].forEach(fase=>{
      const faseEl=document.createElement('div');
      faseEl.className='fase'; faseEl.id='fase-'+fase.id;
      faseEl.innerHTML=`
        <div class="fase-hd" onclick="toggleFase('${fase.id}')">
          <span class="fase-chip" style="background:${fase.chipBg};color:${fase.chipColor}">${fase.title}</span>
          <div class="fase-line"></div>
          <span class="fase-prog" id="fprog-${fase.id}">0/${fase.cards.length}</span>
          <span class="fase-tog open" id="ftog-${fase.id}">▾</span>
        </div>
        <div class="fase-body" id="fbody-${fase.id}"></div>
      `;
      const body=faseEl.querySelector('.fase-body');
      fase.cards.forEach((card)=>{
        const idx=cardIdx++;
        cardMeta[idx]={tab, faseId:fase.id};
        const cs=getCS(idx);
        if(!cs.titulo) cs.titulo=card.titulo;
        if(!cs.processo) cs.processo=card.processo;
        if(!cs.responsavel) cs.responsavel=card.responsavel;
        if(!cs.prazo) cs.prazo=card.prazo;
        if(!cs.problemas||!cs.problemas.length) cs.problemas=[...card.problemas];
        if(!cs.solucoes||!cs.solucoes.length) cs.solucoes=card.solucoes.length?[...card.solucoes]:[''];
        body.appendChild(buildCard(idx,card,cs));
      });
      panel.appendChild(faseEl);
    });
  });
  updateStats();
  updateAllFaseProgs();
  setTimeout(()=>{ document.querySelectorAll('textarea').forEach(ta=>autoResize(ta)); },80);
}

function buildCard(idx,card,cs){
  const wrap=document.createElement('div');
  wrap.className=`card ${cs.status}`;
  wrap.dataset.status=cs.status;
  wrap.dataset.idx=idx;
  wrap.dataset.tab=cardMeta[idx].tab;
  const tagsHtml=card.tags.map(t=>`<span class="tag" style="background:${t.s};color:${t.c}">${t.t}</span>`).join('');
  const probCount=cs.problemas.filter(p=>p.trim()).length;
  const probBadge=probCount?`<span class="tag" style="background:#FDF3F2;color:#C0392B" data-prob="1">⚠ ${probCount} problema${probCount>1?'s':''}</span>`:'';
  wrap.innerHTML=`
    <div class="card-stripe"></div>
    <div class="card-head">
      <div class="card-top">
        <textarea class="card-title-ta" rows="2" placeholder="Nome da etapa..."
          oninput="updateF(${idx},'titulo',this.value);autoResize(this)"
          onfocus="autoResize(this)">${esc(cs.titulo)}</textarea>
        <div class="card-dot"></div>
      </div>
      <div class="card-foot">
        <div class="tags">${tagsHtml}${probBadge}</div>
        <select class="status-sel" onchange="changeStatus(${idx},this.value)">
          <option value="todo"${cs.status==='todo'?' selected':''}>A resolver</option>
          <option value="doing"${cs.status==='doing'?' selected':''}>Em andamento</option>
          <option value="done"${cs.status==='done'?' selected':''}>Resolvido</option>
        </select>
      </div>
    </div>
    <button class="card-expbtn" id="expbtn-${idx}" onclick="toggleDet(${idx})">
      <span class="arr">▾</span> Processo · Problemas · Soluções · Responsável
    </button>
    <div class="card-det" id="det-${idx}">
      <div class="det-sec">
        <div class="det-lbl">Como funciona hoje</div>
        <textarea class="det-input" placeholder="Descreva o processo atual..."
          oninput="updateF(${idx},'processo',this.value);autoResize(this)"
          onfocus="autoResize(this)">${esc(cs.processo)}</textarea>
      </div>
      <div class="det-sec">
        <div class="det-lbl">Problemas identificados</div>
        <div class="list-wrap" id="prob-${idx}">${buildListHtml(idx,'problemas',cs.problemas,'prob-ta','⚠ Descreva o problema...')}</div>
        <button class="btn-add" onclick="addItem(${idx},'problemas')">+ Adicionar problema</button>
      </div>
      <div class="det-sec">
        <div class="det-lbl">Possíveis soluções</div>
        <div class="list-wrap" id="sol-${idx}">${buildListHtml(idx,'solucoes',cs.solucoes,'sol-ta','💡 Descreva uma solução...')}</div>
        <button class="btn-add" onclick="addItem(${idx},'solucoes')">+ Adicionar solução</button>
      </div>
      <div class="det-sec det-grid">
        <div>
          <div class="det-lbl">Responsável</div>
          <input class="det-input" type="text" placeholder="Ex: Juliana, Ana..." value="${esc(cs.responsavel)}"
            oninput="updateF(${idx},'responsavel',this.value)">
        </div>
        <div>
          <div class="det-lbl">Prazo</div>
          <input class="det-input" type="date" value="${esc(cs.prazo)}"
            onchange="updateF(${idx},'prazo',this.value)">
        </div>
      </div>
    </div>
  `;
  return wrap;
}

function buildListHtml(idx,field,items,cls,ph){
  return items.map((s,i)=>`
    <div class="list-row" id="${field}-row-${idx}-${i}">
      <textarea class="list-ta ${cls}" rows="1" placeholder="${ph}"
        oninput="updateItem(${idx},'${field}',${i},this.value);autoResize(this)"
        onfocus="autoResize(this)">${esc(s)}</textarea>
      <button class="btn-rm" onclick="removeItem(${idx},'${field}',${i})">×</button>
    </div>`).join('');
}

// ─────────────────────────────────────────────
// INTERACTIONS
// ─────────────────────────────────────────────
function switchTab(tab, btn){
  currentTab=tab;
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-'+tab).classList.add('active');
  updateStats();
  updateAllFaseProgs();
  // re-apply current filter
  const activeFilter = document.querySelector('.fbtn.active');
  if(activeFilter) filterCards(activeFilter.dataset.filter||'all', activeFilter);
}

function toggleFase(id){
  const body=document.getElementById('fbody-'+id);
  const tog=document.getElementById('ftog-'+id);
  const col=body.classList.toggle('collapsed');
  tog.classList.toggle('open',!col);
}

function toggleDet(idx){
  const det=document.getElementById('det-'+idx);
  const btn=document.getElementById('expbtn-'+idx);
  const open=det.classList.toggle('open');
  btn.classList.toggle('open',open);
  if(open) setTimeout(()=>{ det.querySelectorAll('textarea').forEach(ta=>autoResize(ta)); },20);
}

function changeStatus(idx,value){
  const cs=getCS(idx);
  cs.status=value;
  saveState();
  const card=document.querySelector(`[data-idx="${idx}"]`);
  card.className=`card ${value}`;
  card.dataset.status=value;
  updateStats();
  updateAllFaseProgs();
}

function updateF(idx,field,value){ const cs=getCS(idx); cs[field]=value; saveState(); }

function updateItem(idx,field,i,value){
  const cs=getCS(idx); cs[field][i]=value; saveState(); refreshProbBadge(idx);
}

function addItem(idx,field){
  const cs=getCS(idx); cs[field].push(''); saveState();
  const i=cs[field].length-1;
  const wrap=document.getElementById((field==='problemas'?'prob':'sol')+'-'+idx);
  const cls=field==='problemas'?'prob-ta':'sol-ta';
  const ph=field==='problemas'?'⚠ Descreva o problema...':'💡 Descreva uma solução...';
  const div=document.createElement('div');
  div.id=`${field}-row-${idx}-${i}`; div.className='list-row';
  div.innerHTML=`<textarea class="list-ta ${cls}" rows="1" placeholder="${ph}"
    oninput="updateItem(${idx},'${field}',${i},this.value);autoResize(this)"
    onfocus="autoResize(this)"></textarea>
    <button class="btn-rm" onclick="removeItem(${idx},'${field}',${i})">×</button>`;
  wrap.appendChild(div);
  div.querySelector('textarea').focus();
}

function removeItem(idx,field,i){
  const cs=getCS(idx);
  if(cs[field].length<=1){ cs[field][0]=''; saveState(); const ta=document.querySelector(`#${field}-row-${idx}-${i} textarea`); if(ta) ta.value=''; return; }
  cs[field].splice(i,1); saveState();
  const wrap=document.getElementById((field==='problemas'?'prob':'sol')+'-'+idx);
  const cls=field==='problemas'?'prob-ta':'sol-ta';
  const ph=field==='problemas'?'⚠ Descreva o problema...':'💡 Descreva uma solução...';
  wrap.innerHTML=buildListHtml(idx,field,cs[field],cls,ph);
  wrap.querySelectorAll('textarea').forEach(ta=>autoResize(ta));
  refreshProbBadge(idx);
}

function refreshProbBadge(idx){
  const cs=getCS(idx);
  const card=document.querySelector(`[data-idx="${idx}"]`);
  if(!card) return;
  const tagsWrap=card.querySelector('.tags');
  const ex=tagsWrap.querySelector('[data-prob]'); if(ex) ex.remove();
  const count=cs.problemas.filter(p=>p.trim()).length;
  if(count>0){
    const span=document.createElement('span');
    span.className='tag'; span.dataset.prob='1';
    span.style.background='#FDF3F2'; span.style.color='#C0392B';
    span.textContent=`⚠ ${count} problema${count>1?'s':''}`;
    tagsWrap.appendChild(span);
  }
}

function filterCards(status, btn){
  document.querySelectorAll('.fbtn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  btn.dataset.filter=status;
  const cards=document.querySelectorAll(`#panel-${currentTab} .card`);
  let visible=0;
  cards.forEach(c=>{ const show=status==='all'||c.dataset.status===status; c.style.display=show?'':'none'; if(show) visible++; });
  document.getElementById('empty-state').style.display=visible===0?'block':'none';
}

function updateStats(){
  const cards=document.querySelectorAll(`#panel-${currentTab} .card`);
  let todo=0,doing=0,done=0;
  cards.forEach(c=>{ if(c.dataset.status==='todo') todo++; else if(c.dataset.status==='doing') doing++; else if(c.dataset.status==='done') done++; });
  const total=cards.length;
  document.getElementById('stat-total').textContent=total;
  document.getElementById('stat-doing').textContent=doing;
  document.getElementById('stat-done').textContent=done;
  const pct=total?Math.round((done/total)*100):0;
  document.getElementById('prog-fill').style.width=pct+'%';
  document.getElementById('prog-txt').textContent=`${done} de ${total} etapas resolvidas · ${pct}%`;
}

function updateAllFaseProgs(){
  Object.values(DATA).flat().forEach(fase=>{
    const cards=document.querySelectorAll(`#fbody-${fase.id} .card`);
    const done=[...cards].filter(c=>c.dataset.status==='done').length;
    const el=document.getElementById('fprog-'+fase.id);
    if(el) el.textContent=`${done}/${cards.length}`;
  });
}

// INIT
loadState();
renderAll();
</script>
</body>
